# Route Captain needs one key: PORTKEY_API_KEY (no other keys).
# The app reads a .env file from this folder first, then from the folder above it,
# so a .env one level up (for example submissions/.env) works too.
# To use this folder: copy this file to .env and put your Portkey key below.
PORTKEY_API_KEY=your-portkey-key-here
